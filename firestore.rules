// Reglas de seguridad de Firestore.
//
// - Cada persona solo accede a sus propios datos (users/{su uid}/...), y solo si su correo de Google
//   (verificado) está en la colección "allowed" (un documento por correo, con el correo como ID).
// - Alta automática: al entrar con Google, la app crea allowed/{su correo}. Eso solo se permite
//   mientras el documento config/acceso tenga abierto = "si". Para cerrar las altas nuevas, cambia
//   ese campo a "no" en la consola de Firebase (quienes ya están autorizados siguen igual).
// - Quitar a alguien: borra su documento en allowed (con las altas cerradas no puede volver a entrar).
// - config/acceso solo se edita desde la consola: los clientes no pueden leerlo ni escribirlo.
//
// Se publican en Firebase Console → Firestore Database → Reglas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function autorizado() {
      return verificado()
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email));
    }

    function altasAbiertas() {
      return get(/databases/$(database)/documents/config/acceso).data.abierto == 'si';
    }

    match /allowed/{email} {
      allow get: if verificado() && request.auth.token.email == email;
      allow create: if verificado() && request.auth.token.email == email && altasAbiertas();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }
  }
}
